<?xml version="1.0" encoding="utf-8"?>
<!-- Copia de seguridad automática en Android 7–11. Mismas reglas que
     data_extraction_rules.xml (Android 12+). -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    <exclude domain="root" path="app_flutter/respaldos/" />
</full-backup-content>
