<?xml version="1.0" encoding="utf-8"?>
<!--
  Copia de seguridad automática de Android 12+ (cuenta de Google y paso a
  otro teléfono). Se copia todo (libros, notas, portadas y ajustes) excepto:
  - El almacenamiento seguro del login: está cifrado con una clave que no
    sale del teléfono, así que en otro dispositivo sería ilegible.
  - La copia previa a restaurar (respaldos/): duplicaría el tamaño y Android
    no copia nada si la app supera 25 MB.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
        <exclude domain="root" path="app_flutter/respaldos/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
        <exclude domain="root" path="app_flutter/respaldos/" />
    </device-transfer>
</data-extraction-rules>
