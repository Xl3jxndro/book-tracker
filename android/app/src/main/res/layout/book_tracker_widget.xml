<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de Book Tracker: portada + fondo ambiental (colores de la portada
     difuminados), progreso fino y, durante una sesión, cronómetro con botones
     tipo píldora. Pensado para 4×2 (cabe en ~110 dp de alto). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:forceDarkAllowed="false">

    <!-- Fondo ambiental: la portada reducida y difuminada (la genera Kotlin) -->
    <ImageView
        android:id="@+id/widget_ambient"
        android:forceDarkAllowed="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_scrim"
        android:scaleType="fitXY" />

    <!-- Toda la superficie abre el libro -->
    <LinearLayout
        android:id="@+id/widget_main_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Sin libros -->
        <LinearLayout
            android:id="@+id/widget_no_book_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Book Tracker"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Textos por defecto en español: Kotlin pone los del idioma de la app -->
            <TextView
                android:id="@+id/widget_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="Añade tu primer libro"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/widget_empty_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Toca para empezar"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Portada -->
        <ImageView
            android:id="@+id/widget_cover"
            android:forceDarkAllowed="false"
            android:layout_width="60dp"
            android:layout_height="90dp"
            android:contentDescription="Portada"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_cover_placeholder" />

        <LinearLayout
            android:id="@+id/widget_content_section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_book_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:text="Tu libro actual"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/widget_book_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Autor"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/widget_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="35"
                android:progressDrawable="@drawable/widget_progress_bar_bg" />

            <!-- 35% · 120/340 pág.                Hoy 15/30 min -->
            <LinearLayout
                android:id="@+id/widget_pages_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_pages_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="35% · 120/340 pág."
                    android:textColor="#D9FFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_today_session"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:text="Hoy 15/30 min"
                    android:textColor="#D9FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Sesión: cronómetro + píldoras -->
            <LinearLayout
                android:id="@+id/widget_session_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_session_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="LEYENDO"
                        android:textColor="#B3FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <!-- Avanza solo (sin actualizaciones periódicas desde la app) -->
                    <Chronometer
                        android:id="@+id/widget_chronometer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_pause_button"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/widget_btn_bg"
                    android:contentDescription="Pausar o reanudar"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/widget_ic_pause" />

                <Button
                    android:id="@+id/widget_finish_button"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/widget_btn_finish_bg"
                    android:contentDescription="Finalizar la sesión"
                    android:fontFamily="sans-serif-medium"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Finalizar"
                    android:textAllCaps="false"
                    android:textColor="#111827"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
