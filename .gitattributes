# Saltos de línea: LF en el repositorio y en la carpeta de trabajo.
# Flutter regenera archivos (p. ej. generated_plugin_registrant) con LF; sin
# esto, con core.autocrlf=true aparecían como modificados tras `flutter pub get`.
* text=auto eol=lf

# Scripts de Windows: necesitan CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios (no tocar saltos de línea ni intentar mostrar diffs)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.jar binary
*.jks binary
*.keystore binary
